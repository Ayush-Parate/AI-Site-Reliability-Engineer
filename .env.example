# AI-SRE LLM configuration
# Copy this file to .env and fill in at least one provider.
# Never commit .env.

# Which provider to use first, and which to fall back to.
# Supported: openai, gemini, groq, openrouter, ollama
PRIMARY_PROVIDER=openai
BACKUP_PROVIDER=ollama

# Optional: override the default model per provider (see sre/llm.py for defaults).
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OLLAMA_MODEL=qwen2.5

# API keys (only the providers you use need a key)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Local providers usually need no key, but a base URL is useful
OLLAMA_BASE_URL=http://localhost:11434/v1